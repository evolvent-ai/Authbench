RUN_ID=${RUN_ID:-required-permissions__gpt-5-replay-local}
SOURCE_TASKS_ROOT=${SOURCE_TASKS_ROOT:-tasks}

JOB_NAME=${JOB_NAME:-${RUN_ID}}
PLAN_DIR=${PLAN_DIR:-plans/replay_required/${JOB_NAME}}
DESTINATION_ROOT=${DESTINATION_ROOT:-tasks_replay_required/${RUN_ID}}
POLICY_ROOT=${POLICY_ROOT:-${PLAN_DIR}/policies}
REQUIRED_REPLAY_TASK_SUFFIX=${REQUIRED_REPLAY_TASK_SUFFIX:-required-r1}

MODEL_NAME=${MODEL_NAME:-gpt-5}
N_ATTEMPTS=${N_ATTEMPTS:-3}
N_CONCURRENT_TRIALS=${N_CONCURRENT_TRIALS:-10}
JOBS_DIR=${JOBS_DIR:-jobs}
RETRY_MAX_RETRIES=${RETRY_MAX_RETRIES:-0}

VERIFIER_TIMEOUT_SEC=${VERIFIER_TIMEOUT_SEC:-120}
AGENT_TIMEOUT_SEC=${AGENT_TIMEOUT_SEC:-300}
BUILD_TIMEOUT_SEC=${BUILD_TIMEOUT_SEC:-1800}

CLEAN_DESTINATION=${CLEAN_DESTINATION:-1}
RUN_HARBOR=${RUN_HARBOR:-1}
NO_DELETE=${NO_DELETE:-1}
