RUN_ID=${RUN_ID:-all-tasks-main-local}
STAGES=${STAGES:-oracle,prepare,permission-gen,replay-allowall,replay-generated}
SOURCE_TASKS_ROOT=${SOURCE_TASKS_ROOT:-tasks}

TASKS_GEN_ROOT=${TASKS_GEN_ROOT:-tasks_gen/permission-gen-prepared}
TASKS_REPLAY_ROOT=${TASKS_REPLAY_ROOT:-tasks_replay/${RUN_ID}}
GENERATED_REPLAY_ROOT=${GENERATED_REPLAY_ROOT:-tasks_replay_generated/${RUN_ID}}

PERMISSION_TASK_SUFFIX=${PERMISSION_TASK_SUFFIX:-pg-r1}
ALLOWALL_REPLAY_TASK_SUFFIX=${ALLOWALL_REPLAY_TASK_SUFFIX:-allowall-r1}

CLEAN_PREPARED_ROOTS=${CLEAN_PREPARED_ROOTS:-1}
CLEAN_GENERATED_REPLAY=${CLEAN_GENERATED_REPLAY:-1}
PREBUILD_PREPARED_TASKS=${PREBUILD_PREPARED_TASKS:-0}
PREBUILD_GENERATED_REPLAY_TASKS=${PREBUILD_GENERATED_REPLAY_TASKS:-0}

RUN_HARBOR=${RUN_HARBOR:-1}
NO_DELETE=${NO_DELETE:-1}
EXPERIMENT_JOBS_ROOT=${EXPERIMENT_JOBS_ROOT:-jobs/${RUN_ID}}

ORACLE_JOB_NAME=${ORACLE_JOB_NAME:-${RUN_ID}-oracle}
ORACLE_PLAN_DIR=${ORACLE_PLAN_DIR:-plans/oracle/${ORACLE_JOB_NAME}}
ORACLE_N_ATTEMPTS=${ORACLE_N_ATTEMPTS:-1}
ORACLE_N_CONCURRENT_TRIALS=${ORACLE_N_CONCURRENT_TRIALS:-1}
ORACLE_JOBS_DIR=${ORACLE_JOBS_DIR:-${EXPERIMENT_JOBS_ROOT}}

PERMISSION_GEN_JOB_NAME=${PERMISSION_GEN_JOB_NAME:-${RUN_ID}-permission-gen}
PERMISSION_GEN_PLAN_DIR=${PERMISSION_GEN_PLAN_DIR:-plans/permission_gen/${PERMISSION_GEN_JOB_NAME}}
PERMISSION_GEN_MODEL_NAME=${PERMISSION_GEN_MODEL_NAME:-gpt-5}
PERMISSION_GEN_REASONING_EFFORT=${PERMISSION_GEN_REASONING_EFFORT:-}
PERMISSION_GEN_N_ATTEMPTS=${PERMISSION_GEN_N_ATTEMPTS:-3}
PERMISSION_GEN_N_CONCURRENT_TRIALS=${PERMISSION_GEN_N_CONCURRENT_TRIALS:-10}
PERMISSION_GEN_JOBS_DIR=${PERMISSION_GEN_JOBS_DIR:-${EXPERIMENT_JOBS_ROOT}}
PERMISSION_GEN_MAX_TURNS=${PERMISSION_GEN_MAX_TURNS:-50}
RETRY_MAX_RETRIES=${RETRY_MAX_RETRIES:-0}

REPLAY_MODEL_NAME=${REPLAY_MODEL_NAME:-gpt-5}
REPLAY_ALLOWALL_JOB_NAME=${REPLAY_ALLOWALL_JOB_NAME:-${RUN_ID}-replay-allowall-3x}
REPLAY_ALLOWALL_PLAN_DIR=${REPLAY_ALLOWALL_PLAN_DIR:-plans/replay/${REPLAY_ALLOWALL_JOB_NAME}}
REPLAY_ALLOWALL_N_ATTEMPTS=${REPLAY_ALLOWALL_N_ATTEMPTS:-3}
REPLAY_ALLOWALL_N_CONCURRENT_TRIALS=${REPLAY_ALLOWALL_N_CONCURRENT_TRIALS:-10}
REPLAY_ALLOWALL_JOBS_DIR=${REPLAY_ALLOWALL_JOBS_DIR:-${EXPERIMENT_JOBS_ROOT}}

POLICY_JOB=${POLICY_JOB:-${EXPERIMENT_JOBS_ROOT}/${PERMISSION_GEN_JOB_NAME}}
GENERATED_REPLAY_JOB_NAME=${GENERATED_REPLAY_JOB_NAME:-${RUN_ID}-replay-generated}
GENERATED_REPLAY_PLAN_DIR=${GENERATED_REPLAY_PLAN_DIR:-plans/generated_replay/${GENERATED_REPLAY_JOB_NAME}}
GENERATED_REPLAY_N_ATTEMPTS=${GENERATED_REPLAY_N_ATTEMPTS:-1}
GENERATED_REPLAY_N_CONCURRENT_TRIALS=${GENERATED_REPLAY_N_CONCURRENT_TRIALS:-10}
GENERATED_REPLAY_JOBS_DIR=${GENERATED_REPLAY_JOBS_DIR:-${EXPERIMENT_JOBS_ROOT}}
VERIFIER_TIMEOUT_SEC=${VERIFIER_TIMEOUT_SEC:-120}
AGENT_TIMEOUT_SEC=${AGENT_TIMEOUT_SEC:-300}
BUILD_TIMEOUT_SEC=${BUILD_TIMEOUT_SEC:-1800}
